<?xml version="1.0" encoding="utf-8" ?>
<views:BaseContentPage
    x:Class="DailyConditionApp.Views.RewardSettingsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DailyConditionApp.Views">

    <VerticalStackLayout Padding="12" Spacing="8">
        <Label
            FontAttributes="Bold"
            FontSize="18"
            Text="ご褒美設定" />

        <Label
            Margin="0,12,0,0"
            FontAttributes="Bold"
            Text="ご褒美曜日" />
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <VerticalStackLayout Grid.Column="0" Spacing="4">
                <CheckBox IsChecked="{Binding SundayChecked, Mode=TwoWay}" />
                <Label Text="日" VerticalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <CheckBox IsChecked="{Binding MondayChecked, Mode=TwoWay}" />
                <Label Text="月" VerticalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="4">
                <CheckBox IsChecked="{Binding TuesdayChecked, Mode=TwoWay}" />
                <Label Text="火" VerticalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" Spacing="4">
                <CheckBox IsChecked="{Binding WednesdayChecked, Mode=TwoWay}" />
                <Label Text="水" VerticalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="4" Spacing="4">
                <CheckBox IsChecked="{Binding ThursdayChecked, Mode=TwoWay}" />
                <Label Text="木" VerticalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="5" Spacing="4">
                <CheckBox IsChecked="{Binding FridayChecked, Mode=TwoWay}" />
                <Label Text="金" VerticalOptions="Center" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="6" Spacing="4">
                <CheckBox IsChecked="{Binding SaturdayChecked, Mode=TwoWay}" />
                <Label Text="土" VerticalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <Label
            Margin="0,12,0,0"
            FontAttributes="Bold"
            Text="ご褒美表示テキスト" />
        <Entry Placeholder="例: ご褒美可能！！" Text="{Binding RewardText, Mode=TwoWay}" />

    </VerticalStackLayout>

</views:BaseContentPage>
