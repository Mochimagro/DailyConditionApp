<?xml version="1.0" encoding="utf-8" ?>
<views:BaseContentPage
    x:Class="DailyConditionApp.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DailyConditionApp.Views">

    <VerticalStackLayout Padding="16" Spacing="20">
        <Label Text="設定" FontAttributes="Bold" FontSize="20" />

        <Frame CornerRadius="8" Padding="12">
            <VerticalStackLayout>
                <Label Text="API設定" FontAttributes="Bold" />
                <Button Text="API設定へ" Command="{Binding GoToApiSettingsCommand}" />
            </VerticalStackLayout>
        </Frame>

        <Frame CornerRadius="8" Padding="12">
            <VerticalStackLayout>
                <Label Text="ご褒美設定" FontAttributes="Bold" />
                <Button Text="ご褒美設定へ" Command="{Binding GoToRewardSettingsCommand}" />
            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>

</views:BaseContentPage>
