<?xml version="1.0" encoding="utf-8" ?>
<views:BaseContentPage
    x:Class="DailyConditionApp.Views.ApiSettingsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DailyConditionApp.Views">

    <VerticalStackLayout Padding="12" Spacing="8">
        <Label Text="API設定" FontAttributes="Bold" FontSize="18" />

        <Label Text="Notion Token" />
        <Entry Placeholder="NotionTokenを入力" Text="{Binding NotionToken, Mode=TwoWay}" />

        <Label Text="Database ID" />
        <Entry Placeholder="DatabaseIDを入力" Text="{Binding DatabaseId, Mode=TwoWay}" />
        <Label FontSize="12" Text="※Notion情報は端末に安全に保存されます。" TextColor="Gray" />

        <Label Margin="0,16,0,0" Text="Weather API 設定" FontAttributes="Bold" />
        <Entry Placeholder="Weather API Key" Text="{Binding WeatherApiKey, Mode=TwoWay}" />
        <Entry Keyboard="Numeric" Placeholder="緯度 (Latitude)" Text="{Binding Latitude, Mode=TwoWay}" />
        <Entry Keyboard="Numeric" Placeholder="経度 (Longitude)" Text="{Binding Longitude, Mode=TwoWay}" />
    </VerticalStackLayout>

</views:BaseContentPage>
