<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DailyConditionApp.Views.WeeklyResultsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:DailyConditionApp.Converters"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    Title="週間睡眠スコア">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ScoreToHeightConverter x:Key="ScoreToHeightConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="12" Spacing="10">

        <CollectionView ItemsSource="{Binding WeeklyScores}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="40,*,80" RowDefinitions="Auto">
                        <CheckBox
                            HorizontalOptions="Center"
                            IsChecked="{Binding IsChecked}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding FormattedDate}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="2"
                            HorizontalTextAlignment="End"
                            Text="{Binding DisplayScore}"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
            <Button Command="{Binding CalculateCheckedAverageCommand}" Text="選択平均を計算" />
            <Label Text="{Binding CheckedAverageText}" VerticalOptions="Center" />
        </HorizontalStackLayout>


        <!-- LiveChartsCore を使った棒グラフ表示 -->
        <Grid>
            <lvc:CartesianChart Series="{Binding Series}"
                               XAxes="{Binding XAxes}"
                               YAxes="{Binding YAxes}"
                               HeightRequest="260"
                               LegendPosition="Hidden" />
        </Grid>

    </VerticalStackLayout>
</ContentPage>